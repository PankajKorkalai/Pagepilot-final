NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in         # Clerk sign-in URL
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up         # Clerk sign-up URL
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/   # Clerk sign-in fallback redirect URL
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/   # Clerk sign-up fallback redirect URL

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # Clerk publishable key (starts with pk_test_ or pk_live_)
CLERK_SECRET_KEY=                   # Clerk secret key (starts with sk_test_ or sk_live_)
NEON_BRANCH=main                    # Neon database branch (default: main)
DATABASE_URL=                       # Neon database URL (pooled)
DATABASE_URL_UNPOOLED=              # Neon database URL (unpooled)

# Trigger.dev — get from the dashboard API Keys page
TRIGGER_SECRET_KEY=                 # Trigger.dev secret key (starts with tr_dev_)

NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=  # Liveblocks public key (starts with pk_dev_ or pk_live_)
LIVEBLOCKS_SECRET_KEY=              # Liveblocks secret key (starts with sk_dev_ or sk_live_)

BROWSERBASE_API_KEY=                # Browserbase API key (starts with bb_live_ or bb_test_)

RESEND_API_KEY=                     # Resend API key (starts with re_)

# Sentry
NEXT_PUBLIC_SENTRY_DSN=             # Sentry DSN for client-side error tracking 
SENTRY_DSN=                         # Sentry DSN for server-side error tracking
# Build-time secret for source map upload 
SENTRY_AUTH_TOKEN=